# Local-only API. The development launcher uses this fixed port.
API_PORT=3000
# Set explicitly if another app already uses 5173; no automatic fallback.
UI_PORT=5173
# Repository-relative or absolute. Used by the storage phase.
SOUNDRY_DATA_DIR=data
# Installed Codex CLI with ChatGPT login; mock is an explicit offline demo.
MUSIC_PROVIDER=cli
