# 로컬 loopback API의 고정 포트다. 개발 launcher와 Vite proxy가 같은 3000번을 사용한다.
API_PORT=3000
# 다른 앱이 5173을 쓰면 명시적으로 바꾼다. 자동 포트 변경은 API Origin 허용 목록과 어긋나므로 하지 않는다.
UI_PORT=5173
# 저장소 root 기준 상대 경로 또는 절대 경로. DB·음원·임시 파일은 이 폴더 아래에만 저장한다.
SOUNDRY_DATA_DIR=data
# cli는 설치된 Codex의 기존 ChatGPT 로그인으로 작곡하고 로컬에서 WAV를 합성한다.
# 외부 작곡 요청 없이 동작만 검사하려면 mock을 명시한다. Mock 음원은 완성곡이 아니다.
MUSIC_PROVIDER=cli
